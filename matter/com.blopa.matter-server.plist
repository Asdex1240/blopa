<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.blopa.matter-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--enable-source-maps</string>
    <string>node_modules/matter-server/dist/esm/MatterServer.js</string>
    <string>--storage-path</string>
    <string>data</string>
    <string>--primary-interface</string>
    <string>en1</string>
    <string>--listen-address</string>
    <string>127.0.0.1</string>
    <string>--log-file</string>
    <string>data/matter-server.log</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__DIR__/data/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/data/stderr.log</string>
</dict>
</plist>
